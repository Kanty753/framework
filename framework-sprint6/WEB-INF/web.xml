<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>App Test Framework</display-name>

    <context-param>
        <param-name>controller</param-name>
        <param-value>app.controllers</param-value>
    </context-param>

    <context-param>
        <param-name>pafSource</param-name>
        <param-value>WEB-INF/</param-value>
    </context-param>
    <context-param>
        <param-name>extension</param-name>
        <param-value>.jsp</param-value>
    </context-param>

    <listener>
        <listener-class>listener.AppListener</listener-class>
    </listener>

    <listener>
        <listener-class>listener.SessionListener</listener-class>
    </listener>


    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>core.DispatcherServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>          <!-- 10 Mo -->
            <max-request-size>52428800</max-request-size>    <!-- 50 Mo -->
            <file-size-threshold>262144</file-size-threshold> <!-- 256 Ko -->
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>/app/*</url-pattern>
    </servlet-mapping>

</web-app>
